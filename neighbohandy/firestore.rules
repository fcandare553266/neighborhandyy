rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['resident', 'freelancer'];
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && (request.auth.uid != userId
          || request.resource.data.role == resource.data.role
          || (resource.data.role == 'resident'
            && request.resource.data.role == 'freelancer'));
      allow delete: if isAdmin();
    }

    match /freelancer_applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'approved'
          && request.resource.data.status == 'completed'
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (isAdmin() || providerId == request.auth.uid);
      allow delete: if isAdmin() || providerId == request.auth.uid;
    }

    match /freelancers/{freelancerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (isAdmin() || freelancerId == request.auth.uid);
      allow delete: if isAdmin() || freelancerId == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, write: if signedIn();
    }
  }
}
